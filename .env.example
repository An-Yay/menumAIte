# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Google Cloud API key with "Places API (New)" enabled.
# Used for restaurant discovery and reviews.
GOOGLE_API_KEY=your_key_here

# OpenAI API key. Used by the LLM-backed tools (dietary reasoning, menu
# extraction/translation, review analysis) and by the Strands agent.
OPENAI_API_KEY=your_key_here

# Optional: override the OpenAI model used by the tools and agent.
# LLM_MODEL_ID=gpt-4o-mini
